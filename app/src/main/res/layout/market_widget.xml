<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#101216">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ARZ-NET | قیمت بازار" android:textColor="#79A9FF" android:textSize="14sp" android:textStyle="bold"/>
<ImageButton android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="36dp" android:background="#28364C" android:contentDescription="تازه‌سازی قیمت‌ها" android:src="@android:drawable/ic_popup_sync" android:tint="#F3F5F7"/>
</LinearLayout>
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="در حال دریافت قیمت‌ها…" android:textColor="#9AA4B2" android:textSize="10sp"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp" android:background="#303640"/>
<TextView android:id="@+id/widget_usd" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="دلار آزاد: —" android:textColor="#F3F5F7" android:textSize="13sp" android:textStyle="bold"/>
<TextView android:id="@+id/widget_gold" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="طلای ۱۸ عیار: —" android:textColor="#F3F5F7" android:textSize="13sp"/>
<TextView android:id="@+id/widget_coin" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="سکه امامی: —" android:textColor="#F3F5F7" android:textSize="13sp"/>
<TextView android:id="@+id/widget_usdt" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="تتر: —" android:textColor="#F3F5F7" android:textSize="13sp"/>
</LinearLayout>
